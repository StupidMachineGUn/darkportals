DOMAIN=game.example.com
DB_PASSWORD=change-me-long-random
JWT_SECRET=change-me-another-long-random-string
VERSION=0.1.0
# Admin usernames (comma separated, case-insensitive). Empty = no admins.
ADMINS=
# Set CF=1 only if the site is proxied by Cloudflare (use real visitor IP for rate limits).
CF=0
# Accounts allowed per IP address (0 = unlimited). IP_ALLOW = comma separated IPs exempt from the limit (e.g. family on one connection).
IP_LIMIT=1
# off | log | on  (on = reject saves with duplicated or forged items)
SERVER_AUTH=log
IP_ALLOW=
